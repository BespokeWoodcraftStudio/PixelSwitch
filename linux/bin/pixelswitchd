#!/usr/bin/env python3
"""pixelswitchd: launcher for the background service (systemd user service pixelswitch.service).

Spec 5.2: the process puts the real path of its own install folder (the one holding the
``pixelswitch`` package and ``VERSION``) first on ``sys.path``, so a running process never loads another
version's code even after ``current`` is flipped, and sets ``umask 0o077`` before anything is created.
"""
import os
import sys

os.umask(0o077)
_INSTALL_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, _INSTALL_DIR)

from pixelswitch.daemon import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
